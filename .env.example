# Copy this file to .env and set real values (do NOT commit .env)

# -----------------
# MySQL
# -----------------
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=hrms_db

# -----------------
# Spring datasource
# -----------------
SPRING_DATASOURCE_URL=jdbc:mysql://hrms-mysql:3306/hrms_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me

# -----------------
# JWT
# -----------------
JWT_SECRET=change_this_minimum_32_chars_long
JWT_EXPIRATION=86400000

# -----------------
# CORS / Websocket
# -----------------
CORS_ALLOWED_ORIGINS=https://app.truecorehr.com
WEBSOCKET_ALLOWED_ORIGINS=https://app.truecorehr.com

# -----------------
# App
# -----------------
APP_BASE_URL=https://api.truecorehr.com
APP_COMPANY_NAME=Truerize HRMS
APP_ADMIN_EMAIL=admin@yourcompany.com

# -----------------
# Email (optional)
# -----------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
